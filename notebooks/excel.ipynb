       "                            const childTable = document.createElement(&quot;table&quot;)\n",
       "                            childTable.className = &quot;dataframe&quot;\n",
       "                            childTable.id = &quot;df_&quot; + frameId\n",
       "                            let childDf = rootDf.childFrames[frameId]\n",
       "                            childTable.df = childDf\n",
