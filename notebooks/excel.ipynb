       "\n",
       "        this.computeRenderData = function (df) {\n",
       "            let result = []\n",
       "            let pos = 0\n",
       "            for (let col = 0; col &lt; df.cols.length; col++) {\n",
       "                if (df.cols[col].parent === undefined)\n",
